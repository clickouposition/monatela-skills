# Copy this file to ".env" and fill in your own API keys.
# Never commit your real .env to git — it is gitignored on purpose.
# Never paste these keys into a chat with Claude — load them from this file.

# AssemblyAI: word-level transcription with accurate timestamps.
# Get a free key at https://www.assemblyai.com/  (free tier covers ~5 hours)
ASSEMBLYAI_API_KEY=your-assemblyai-key-here

# Google Gemini: sentence-level transcription used as a coarse fallback.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here
